# =============================================================================
# Homelab Slack ChatOps Gateway & MCP Server Environment Configuration
# Copy to ~/.config/homelab-chatops/chatops.env (chmod 600)
# =============================================================================

# Slack Socket Mode Credentials (Outbound WebSocket - Zero Open Router Ports)
SLACK_BOT_TOKEN=<YOUR_SLACK_BOT_TOKEN>
SLACK_APP_TOKEN=<YOUR_SLACK_APP_TOKEN>

# Strict Comma-Separated Slack User ID Whitelist (Fail-Closed Authorization)
USER_WHITELIST=U0123456789

# Slack Channel IDs
SLACK_MEDIA_CHANNEL=C0123456789
SLACK_ALERTS_CHANNEL=C0987654321

# Inter-Service Mutual Authentication for media-sync (Sync.Sharp)
WEBHOOK_SECRET_TOKEN=<REPLACE_WITH_32_BYTE_HEX_SECRET>
MEDIA_SYNC_WEBHOOK_URL=http://192.168.1.211:30080/api/v1/sync/trigger

# Candidate Batch State Store (24-Hour TTL)
CANDIDATE_BATCH_TTL_SECONDS=86400
CANDIDATE_STATE_PATH=/home/gman/.local/share/homelab-chatops/candidate_state.json

# Plex Media Server Library Deduplication (Issue #42)
PLEX_URL=http://192.168.1.210:32400
PLEX_TOKEN=<YOUR_PLEX_SERVER_TOKEN>
EXISTING_MOVIES_INDEX_PATH=/state/existing-movies.json

# Allowed SSH Nodes for Non-Destructive Health Probes
ALLOWED_SSH_NODE_IPS=192.168.1.180,192.168.1.210,192.168.1.211,192.168.1.50
HOMELAB_SSH_USER=ubuntu
