# Local secret variable assignments (Contains the live API tokens)
*.tfvars
*.tfvars.json
*.pkrvars.hcl
*.tfvars.hcl
*.env

# Local Terraform execution cache and plugin binaries
.terraform/
.terraform.lock.hcl

# Local state tracking files (Can contain plain-text parsed secrets)
*.tfstate
*.tfstate.*

# Crash logs and developer overrides
crash.log
*.tfplan

# IDE and editor specific files
.vscode/
.idea/

# Ignore the directory where ISO images are downloaded for VM provisioning
downloaded_iso_path/

# Local backup archives
backup/

# Node.js dependencies and logs
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Docker local secrets, runtime state, and staging data
docker/**/.env
docker/**/data/
docker/**/config.json
docker/**/config.local.json
docker/**/appsettings.local.json
docker/**/docker-compose.local.yaml
docker/**/bin/
docker/**/obj/

# Python bytecode cache
__pycache__/
*.py[cod]

# Homepage local runtime generated files and logs
kubernetes/applications/homepage/config/logs/
kubernetes/applications/homepage/config/custom.js
kubernetes/applications/homepage/config/docker.yaml
kubernetes/applications/homepage/config/proxmox.yaml

