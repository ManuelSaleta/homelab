# ==============================================================================
# Environment Variables Template for Homelab Media Acquisition Containers
# Copy to .env (git-ignored) and populate secrets before running `make up`.
# ==============================================================================

# Process Ownership & Timezone (Matches homelab standard UID/GID 1000:1000)
PUID=1000
PGID=1000
TZ=America/New_York

# 1. NordLynx WireGuard Container (ghcr.io/bubuntux/nordlynx)
# Extract while connected to NordVPN via: sudo wg show nordlynx private-key
NORDLYNX_PRIVATE_KEY=UNCONFIGURED_NORDLYNX_PRIVATE_KEY
NORDVPN_QUERY=filters\[servers_groups\]\[identifier\]=legacy_p2p
NET_LOCAL=192.168.1.0/24

# 2. Localhost WebUI Ports
PROWLARR_PORT=9696
QBIT_WEBUI_PORT=8080

# 3. Persistent Config & Staging Paths
PROWLARR_CONFIG_DIR=./data/prowlarr
QBIT_CONFIG_DIR=./data/qbittorrent
DOWNLOADS_STAGING_DIR=./data/downloads
SYNC_STATE_DIR=./data/sync-state
SYNC_CONFIG_FILE=../containers/vpn-media-sync/config.example.toml

# 4. Restricted SSH Key for micro-nas (192.168.1.250) rrsync transfer
MEDIASYNC_SSH_KEY_PATH=/home/gman/.ssh/id_ed25519_mediasync
SSH_KNOWN_HOSTS_PATH=/home/gman/.ssh/known_hosts
