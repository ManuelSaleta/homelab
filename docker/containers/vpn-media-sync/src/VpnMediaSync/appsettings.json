{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "PlexClientOptions": {
    "ServerUrl": "https://plex.freesalty.com",
    "Token": "",
    "ClientIdentifier": "plex-media-polling-mothership"
  },
  "Schedule": {
    "IntervalMinutes": 30,
    "CronExpression": "*/30 * * * *",
    "LockFile": "/tmp/vpn-media-sync.lock",
    "WebhookPort": 5050,
    "WebhookSecretToken": "UNCONFIGURED_WEBHOOK_SECRET_TOKEN",
    "StateFilePath": "/state/state.json"
  },
  "Vpn": {
    "Provider": "nordlynx",
    "RequiredInterface": "wg0",
    "PauseTorrentsWhenDisconnected": true
  },
  "Trending": {
    "Enabled": true,
    "PopularMoviesUrl": "https://popular-movies-data.stevenlu.com/movies.json",
    "MovieFeedUrls": [
      "https://popular-movies-data.stevenlu.com/movies.json",
      "https://s3.amazonaws.com/popular-movies/movies.json"
    ],
    "PopularTvUrl": null,
    "TvFeedUrls": [],
    "CustomQueries": [],
    "CustomTvQueries": [
      "Severance",
      "The Mandalorian",
      "Loki",
      "Suits"
    ]
  },
  "Indexer": {
    "Type": "prowlarr",
    "BaseUrl": "http://127.0.0.1:9696",
    "ApiKey": "UNCONFIGURED_PROWLARR_API_KEY",
    "MinSeeders": 50,
    "MaxGrabPerRun": 3
  },
  "Filters": {
    "Movies": {
      "CategoryIds": [
        2000,
        2040,
        2045
      ],
      "MinSizeMb": 1500,
      "MaxSizeMb": 16000,
      "AllowedPatterns": [
        "1080p",
        "2160p",
        "4K"
      ],
      "BlockedPatterns": [
        "720p",
        "480p",
        "576p",
        "CAM",
        "HDCAM",
        "TS",
        "TELESYNC",
        "\\.exe$",
        "\\.scr$",
        "\\.rar$",
        "\\.zip$",
        "\\.lnk$"
      ]
    },
    "Tv": {
      "CategoryIds": [
        5000,
        5040,
        5045
      ],
      "MinSizeMb": 250,
      "MaxSizeMb": 35000,
      "PreferSeasonPacks": true,
      "AllowedPatterns": [
        "1080p",
        "2160p",
        "4K"
      ],
      "BlockedPatterns": [
        "720p",
        "480p",
        "576p",
        "CAM",
        "TS",
        "\\.exe$",
        "\\.scr$",
        "\\.rar$",
        "\\.zip$"
      ]
    }
  },
  "Downloader": {
    "Client": "qbittorrent",
    "BaseUrl": "http://127.0.0.1:8080",
    "Username": "admin",
    "Password": "UNCONFIGURED_QBIT_PASSWORD",
    "StagingDir": "/downloads",
    "RemotePathPrefix": "/downloads",
    "RatioLimit": 1.0,
    "SeedingTimeLimitMinutes": 1440
  },
  "Rsync": {
    "Enabled": true,
    "VerifyWithFfprobe": true,
    "SshUser": "gman",
    "SshHost": "192.168.1.250",
    "SshKey": "/home/appuser/.ssh/id_ed25519_mediasync",
    "DestMoviesDir": "/mnt/export/storage/plex/media/Movies",
    "DestTvDir": "/mnt/export/storage/plex/media/TV Shows",
    "Chown": "1000:1000",
    "RemoveLocalAfterSync": true
  }
}
