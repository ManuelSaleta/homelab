#cloud-config
autoinstall:
  version: 1

  identity:
    hostname: k3s-node
    username: ${ssh_username}
    password: "${vm_password_hash}"

  user-data:
    disable_root: true
    lock_passwd: true

  shutdown: reboot

  ssh:
    install-server: true
    allow-pw: false
    authorized-keys:
      - "${ssh_public_key}"

  storage:
    layout:
      name: direct

  packages:
    - qemu-guest-agent
    - curl
    - openssh-server
    # K3s persistent storage clients
    - nfs-common
    - open-iscsi

  late-commands:
    # 1. Clear cloud-init states so it treats the first real boot cleanly
    - curtin in-target -- cloud-init clean
    # 2. Fix passwordless sudo by writing a dedicated drop-in file directly into the target filesystem
    - echo "${ssh_username} ALL=(ALL) NOPASSWD:ALL" > /target/etc/sudoers.d/${ssh_username}
    - chmod 440 /target/etc/sudoers.d/${ssh_username}
    - echo 'Autoinstall complete'
